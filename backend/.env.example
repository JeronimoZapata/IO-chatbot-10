# Proveedor de IA. Actualmente el provider operativo es "gemini".
AI_PROVIDER=gemini

# Modelo a usar (para gemini, por ejemplo: gemini-2.5-flash o gemini-2.5-pro).
AI_MODEL=gemini-2.5-flash

# Temperatura del modelo (0 = determinista, valores mayores = mas creativo).
# Recomendado 0: el agente resuelve calculos, donde la reproducibilidad y la
# precision importan mas que la variedad de redaccion.
AI_TEMPERATURE=0

# API key de Google Gemini. Obtene la tuya en https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# API key de OpenAI (no requerida con AI_PROVIDER=gemini).
OPENAI_API_KEY=

# Puerto del backend.
PORT=3001
